{
  "name": "linux-app-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "bun test",
    "tui:dev": "cargo run --manifest-path src-tauri/Cargo.toml -p systemd-service-tui --",
    "tui:build": "cargo build --manifest-path src-tauri/Cargo.toml -p systemd-service-tui --release",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "^1.4.2",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
